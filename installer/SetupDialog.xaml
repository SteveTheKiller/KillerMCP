<Window x:Class="KillerMCP.Setup.SetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:KillerMCP.Setup"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KillerMCP Setup" Width="390" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="./Assets/#Killer Sans UI, Segoe UI" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="7"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KillerMCP-Setup;component/Themes/Black.xaml"/>
                <ResourceDictionary Source="/KillerMCP-Setup;component/Themes/Accents/Black/Magenta.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <FontFamily x:Key="Wordmark">./Assets/#Punktype</FontFamily>
        <FontFamily x:Key="WordmarkAccent">./Assets/#Lacquer</FontFamily>
        <FontFamily x:Key="BrandSans">./Assets/#Killer Sans</FontFamily>
        <Style x:Key="SurfaceButton" TargetType="Button">
            <Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="12,2"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid><Border x:Name="FaceRing" IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=Face}" BorderThickness="{Binding BorderThickness, ElementName=Face}" BorderBrush="{Binding Background, ElementName=Face}" Margin="{Binding Margin, ElementName=Face}" Visibility="{Binding Visibility, ElementName=Face}" Opacity="{Binding Opacity, ElementName=Face}"/><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border></Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource OutlinePressedBrush}"/><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource OutlineBtnBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid><Border x:Name="FaceRing" IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=Face}" BorderThickness="{Binding BorderThickness, ElementName=Face}" BorderBrush="{Binding Background, ElementName=Face}" Margin="{Binding Margin, ElementName=Face}" Visibility="{Binding Visibility, ElementName=Face}" Opacity="{Binding Opacity, ElementName=Face}"/><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border></Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource SelectionBg}"/><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource SelectionBg}"/><Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource OutlinePressedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="10" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource WindowCornerRadius}">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.72"/></Border.Effect>
        <Grid ClipToBounds="True">
            <Border x:Name="GrainLayer" CornerRadius="{DynamicResource WindowCornerRadius}" IsHitTestVisible="False" Opacity="0.24"/>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="1">
                    <Grid Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <icons:AppIcon Source="Assets/mcp.png" Width="27" Height="27" VerticalAlignment="Center" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Grid VerticalAlignment="Center" Margin="0,-18,0,-22"><Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform><TextBlock Foreground="#D8000000" Opacity="0.45" Margin="1,2,-1,-2" IsHitTestVisible="False" FontFamily="{StaticResource Wordmark}" FontSize="15"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer"/><Run Text="MCP" FontFamily="{StaticResource WordmarkAccent}" FontSize="22.52"/></TextBlock><TextBlock FontFamily="{StaticResource Wordmark}" FontSize="15"><Run Text="Killer"/><Run Text="MCP" FontFamily="{StaticResource WordmarkAccent}" FontSize="22.52" Foreground="{DynamicResource AccentLogo}"/></TextBlock></Grid>
                        </StackPanel>
                        <Button Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" ToolTip="Close" AutomationProperties.Name="Close">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><TextBlock x:Name="CloseGlyph" Text="&#x2715;" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseGlyph" Property="Foreground" Value="#e04444"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                        </Button>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="24,18,24,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="NoticeRing" Width="28" Height="28" CornerRadius="14" BorderThickness="2" Background="{DynamicResource PaneBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock x:Name="NoticeGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="HeadingText" FontFamily="{StaticResource BrandSans}" FontSize="18" TextOptions.TextFormattingMode="Ideal" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailText" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SurfaceButton}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="OkButton" Content="Uninstall" Style="{StaticResource OutlineButton}" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
