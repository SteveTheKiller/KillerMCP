<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>KillerMCP-Setup</AssemblyName>
    <ApplicationIcon>..\assets\KillerMCP.ico</ApplicationIcon>
    <Version>0.4.1</Version>
    <AssemblyVersion>0.4.1.0</AssemblyVersion>
    <FileVersion>0.4.1.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="KillerMCP.payload.zip" Condition="'$(PayloadZip)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\mcp.png" />
    <Resource Include="..\assets\KillerMCP.ico" Link="Assets\app-icon.ico" />
    <Resource Include="Assets\KillerSans-Regular.ttf" />
    <Resource Include="Assets\KillerSansUI-Regular.ttf" />
    <Resource Include="Assets\Punktype.ttf" />
    <Resource Include="Assets\Lacquer-Regular.ttf" />
  </ItemGroup>
  <Target Name="RequirePayload" BeforeTargets="CoreCompile">
    <Error Condition="'$(PayloadZip)' == '' or !Exists('$(PayloadZip)')" Text="Build the verified native payload before compiling the installer." />
  </Target>
</Project>
