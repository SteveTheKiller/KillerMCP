<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>KillerMCP</AssemblyName>
    <RootNamespace>KillerMCP</RootNamespace>
    <Version>0.9.7</Version>
    <ReleaseDate>2026-11-21</ReleaseDate>
    <ApplicationIcon>assets\KillerMCP.ico</ApplicationIcon>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <!-- The host also runs as the elevated repair helper, so DOTNET_STARTUP_HOOKS must never load code into it. -->
    <StartupHookSupport>false</StartupHookSupport>
    <!-- The regular package publishes as one file, which turns this analyzer on and adds its package.
         Turning it on for every build keeps the build and the publish on one locked package set. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Both shipping runtimes are restored every time, so the lock file also covers each package's publish. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**;artifacts\**;dist\**;**\node_modules\**;**\.git</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Configuration\**;Shell\**;installer\**;tests\**;dependencies\**" />
    <!-- Separate programs and the shared engine remain browsable from the root project. -->
    <None Include="Configuration\**\*.cs;Shell\**\*.cs;installer\**\*.cs;tests\**\*.cs;dependencies\**\*.cs;**\*.resx" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <None Remove="Features\Browser\browser-companion.html" />
    <EmbeddedResource Include="Features\Browser\browser-companion.html" LogicalName="KillerMCP.browser-companion.html" />
    <ProjectReference Include="dependencies\KillerTools\src\KillerTools.Engine\KillerTools.Engine.csproj" />
    <Compile Include="installer\DownloadedSetups.cs" Link="Services\DownloadedSetups.cs" />
    <InternalsVisibleTo Include="KillerMCP.Runtime.Checks" />
    <!-- The SDK otherwise picks this version from its own patch level, which would tie the lock file to one SDK. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>
</Project>
