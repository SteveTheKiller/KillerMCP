<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework ships with Windows, so the notifier carries no runtime of its own. -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>KillerMCP.Notify</AssemblyName>
    <RootNamespace>KillerMCP.Notify</RootNamespace>
    <ApplicationIcon>..\assets\KillerMCP.ico</ApplicationIcon>
    <Version>0.9.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\installer\ReleaseSignature.cs" Link="ReleaseSignature.cs" />
    <Compile Include="..\installer\DownloadedSetups.cs" Link="DownloadedSetups.cs" />
    <Compile Include="..\installer\UpdatePreferences.cs" Link="UpdatePreferences.cs" />
    <Resource Include="Assets\mcp.png" />
    <Resource Include="..\assets\KillerMCP.ico" Link="Assets\app-icon.ico" />
    <Resource Include="Assets\KillerSans-Regular.ttf" />
    <Resource Include="..\installer\Assets\KillerSansUI-Regular.ttf" Link="Assets\KillerSansUI-Regular.ttf" />
    <Resource Include="Assets\Punktype.ttf" />
    <Resource Include="Assets\Lacquer-Regular.ttf" />
  </ItemGroup>
  <ItemGroup>
    <!-- KillerUI kit theme dictionaries (Black with the Magenta accent), shared at the repo root. -->
    <Page Include="..\Themes\Black.xaml" Link="Themes\Black.xaml" />
    <Page Include="..\Themes\Accents\Black\Magenta.xaml" Link="Themes\Accents\Black\Magenta.xaml" />
  </ItemGroup>
</Project>
