<Project Sdk="Microsoft.NET.Sdk">
  <!-- Setup runs on .NET Framework 4.8, where path handling differs from .NET 10, so its folder rules are checked there. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Compile Include="../../installer/ManifestPaths.cs" Link="ManifestPaths.cs" />
    <Compile Include="../../installer/UpdatePreferences.cs" Link="UpdatePreferences.cs" />
  </ItemGroup>
</Project>
