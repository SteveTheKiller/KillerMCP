<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>KillerMCP.Configure</AssemblyName>
    <RootNamespace>KillerMCP.Configuration</RootNamespace>
    <Version>0.9.5</Version>
    <!-- Published as one file, so the analyzer and its package are on for every build and the lock file matches. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KillerMCP.Clients.Checks" />
  </ItemGroup>
</Project>
