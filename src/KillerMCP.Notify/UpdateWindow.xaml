<Window x:Class="KillerMCP.Notify.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KillerMCP Update" Width="520" Height="350"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        FontFamily="Segoe UI" Foreground="#f4edf3" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="8"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <FontFamily x:Key="Wordmark">./Assets/#Typewriter - a602 (dead postman 2004)</FontFamily>
        <SolidColorBrush x:Key="Fuchsia" Color="#ff2bbd"/>
        <Style x:Key="UpdateButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Foreground" Value="#ff52c9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Fuchsia}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#ff2bbd"/>
                                <Setter Property="Foreground" Value="#13000d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#7a155f"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LaterButton" TargetType="Button" BasedOn="{StaticResource UpdateButton}">
            <Setter Property="Foreground" Value="#d3c7cf"/>
            <Setter Property="BorderBrush" Value="#5c4757"/>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cfbdca"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseFace" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseFace" Property="Background" Value="#7a155f"/><Setter Property="Foreground" Value="#ffffff"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseFace" Property="Background" Value="#ff2bbd"/><Setter Property="Foreground" Value="#13000d"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#ff52c9"/>
            <Setter Property="Background" Value="#24101f"/>
            <Setter Property="BorderBrush" Value="#7a155f"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><ContentPresenter/></ControlTemplate>
                                </ToggleButton.Template>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                        <TextBlock Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   Foreground="#f4edf3" Text="{TemplateBinding SelectionBoxItem}"/>
                                        <Border Grid.Column="1" BorderBrush="#7a155f" BorderThickness="1,0,0,0">
                                            <Path Width="8" Height="5" Stretch="Fill" Fill="#ff52c9" Data="M 0 0 L 8 0 L 4 5 Z"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,2,0,0" Background="#171116" BorderBrush="#ff2bbd" BorderThickness="1" CornerRadius="3">
                                    <ScrollViewer MaxHeight="220"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#f4edf3"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemFace" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFace" Property="Background" Value="#7a155f"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFace" Property="Background" Value="#a71980"/><Setter Property="Foreground" Value="#ffffff"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="12" Background="#121012" BorderBrush="#ff2bbd" BorderThickness="1" CornerRadius="8">
        <Border.Effect><DropShadowEffect Color="#ff168f" BlurRadius="24" ShadowDepth="0" Opacity="0.48"/></Border.Effect>
        <Grid ClipToBounds="True">
            <Border x:Name="GrainLayer" IsHitTestVisible="False" Opacity="0.42" CornerRadius="8"/>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="Transparent" BorderThickness="0" CornerRadius="8,8,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="15,0,8,0">
                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Wordmark}" FontSize="16">
                            <Run Text="Killer"/><Run Text="MCP" FontSize="21" Foreground="{StaticResource Fuchsia}"/>
                        </TextBlock>
                        <Button Width="30" Height="30" HorizontalAlignment="Right" Style="{StaticResource CloseButton}"
                                FontSize="12" Content="✕" Cursor="Hand" Click="Later_Click"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="24,18,26,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="Assets/mcp.png" Width="96" Height="96" HorizontalAlignment="Left" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect><DropShadowEffect Color="#ff2bbd" BlurRadius="13" ShadowDepth="0" Opacity="0.58"/></Image.Effect>
                    </Image>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeadingText" Text="A new KillerMCP is ready" FontFamily="{StaticResource Wordmark}" FontSize="21" Foreground="#ffffff"/>
                        <TextBlock x:Name="VersionText" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12.5" Foreground="#ff52c9"/>
                        <TextBlock x:Name="BodyText" Margin="0,9,0,0" FontSize="12.5" LineHeight="19" Foreground="#d3c7cf" TextWrapping="Wrap"
                                   Text="Update the local host, reconnect supported agent clients, and pick up the newest Killer tools."/>
                        <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11" Foreground="#ad97a7" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="24,0,24,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="#ad97a7" FontSize="11.5" Text="Future updates:"/>
                    <ComboBox x:Name="BehaviorBox" Grid.Column="1" Width="190" Height="28" HorizontalAlignment="Right"
                              SelectionChanged="BehaviorBox_SelectionChanged">
                        <ComboBoxItem Tag="off">Do not check</ComboBoxItem>
                        <ComboBoxItem Tag="check">Check and ask</ComboBoxItem>
                        <ComboBoxItem Tag="download">Download and ask</ComboBoxItem>
                        <ComboBoxItem Tag="install">Install automatically</ComboBoxItem>
                    </ComboBox>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button x:Name="LaterButton" Content="Later" Style="{StaticResource LaterButton}" Margin="0,0,10,0" Click="Later_Click"/>
                    <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource UpdateButton}" IsDefault="True" Click="Update_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
